{
  "expo": {
    "name": "Split Your Trip",
    "slug": "splitYourTrip",
    "version": "1.0.34",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "splityourtrip",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.splityourtrip.app"
    },
    "android": {
      "package": "com.splityourtrip",
      "versionCode": 35,
      "adaptiveIcon": {
        "backgroundColor": "#0b1122",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "SEND",
          "data": [
            { "mimeType": "image/*" },
            { "mimeType": "text/plain" },
            { "mimeType": "*/*" }
          ],
          "category": ["DEFAULT"]
        },
        {
          "action": "SEND_MULTIPLE",
          "data": [
            { "mimeType": "image/*" }
          ],
          "category": ["DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0b1122"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#6366F1"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
